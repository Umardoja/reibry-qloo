# Copy to .env.local and add only local development credentials.
# This example intentionally contains placeholders only.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# mock is for development only; production requires nvidia or gemini.
AI_PROVIDER=mock
AI_ALLOW_MOCK_FALLBACK=false
NVIDIA_API_KEY=your_nvidia_api_key
GEMINI_API_KEY=your_gemini_api_key

NVIDIA_REASONING_MODEL=
NVIDIA_MULTIMODAL_MODEL=
NVIDIA_EMBEDDING_MODEL=
NVIDIA_REQUEST_TIMEOUT_MS=
NVIDIA_STRUCTURED_TIMEOUT_MS=
GEMINI_MODEL=
GEMINI_REQUEST_TIMEOUT_MS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
REIBRY_APP_URL=http://localhost:3000
REIBRY_TEST_EMAIL_A=disposable-user-a@example.test
REIBRY_TEST_PASSWORD_A=replace_with_disposable_password_a
REIBRY_TEST_EMAIL_B=disposable-user-b@example.test
REIBRY_TEST_PASSWORD_B=replace_with_disposable_password_b

# Server-only Qloo. Direct HTTPS permission is UNVERIFIED; await event credential instructions.
# Enable only after explicit authorization for the selected transport.
# Plain Node scripts do not auto-load .env.local; use a secure process environment.
QLOO_API_KEY=your_qloo_hackathon_key
QLOO_LIVE_ENABLED=false
QLOO_TIMEOUT_MS=8000
QLOO_RECEIPT_SECRET=replace_with_random_local_secret_at_least_32_characters


